# Required for running tests against the real application
TEST_USER_EMAIL=your-test-email@example.com
TEST_PASSWORD=your-test-password

# WireMock: host port published by docker-compose and used by the tests
WIREMOCK_HOST=localhost
WIREMOCK_PORT=9999

# Optional overrides
APP_BASE_URL=https://webqa.mercdev.com
API_BASE_URL=https://webqa.mercdev.com/api/v1
# Local copy (docker compose up -d --wait petstore): http://localhost:8085/api/v3
PETSTORE_BASE_URL=https://petstore3.swagger.io/api/v3
WEBDRIVER_BROWSER=chrome
WEBDRIVER_HEADLESS=false
# Selenium Grid instead of a local browser; -Dremote=true on the Gradle command line does the same
WEBDRIVER_REMOTE=false
SELENIUM_GRID_URL=http://localhost:4444/wd/hub
# Timeouts in seconds: UI explicit waits, API connect/read, Petstore client
WEBDRIVER_TIMEOUT=10
API_TIMEOUT=10
PETSTORE_TIMEOUT=30
