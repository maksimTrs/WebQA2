<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- %X{test}: the running test, set by TestLogListener. No %highlight: ANSI codes end up in JUnit XML and CI logs -->
    <property name="PATTERN" value="%d{HH:mm:ss.SSS} [%thread] %-5level [%X{test:-}] %logger{36} - %msg%n"/>

    <!-- Console: INFO and up, one line per API call -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
        <encoder>
            <pattern>${PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- File: everything, including DEBUG headers and bodies. Under build/ so CI can upload it; one file per run -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>build/logs/test.log</file>
        <append>false</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{test:-}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Per-test log attached to Allure by TestLogListener: INFO and up, the steps without the bodies -->
    <appender name="TEST_LOG" class="com.webqa.tests.logging.TestLogAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
        <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
    </appender>

    <logger name="com.webqa" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="TEST_LOG"/>
    </root>
</configuration>
