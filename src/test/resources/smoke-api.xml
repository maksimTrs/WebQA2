<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Smoke API Suite" parallel="methods" thread-count="2">
    <listeners>
        <listener class-name="com.webqa.tests.listeners.TestListener"/>
    </listeners>
    <test name="Critical API Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="com.webqa.tests.api"/>
        </packages>
    </test>
</suite>
