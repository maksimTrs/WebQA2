<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Regression Test Suite" parallel="tests" thread-count="3">
    <listeners>
        <listener class-name="com.webqa.tests.listeners.TestListener"/>
    </listeners>

    <!-- Chrome UI Tests -->
    <test name="Chrome UI Tests">
        <parameter name="browser" value="chrome"/>
        <packages>
            <package name="com.webqa.tests.ui"/>
        </packages>
    </test>

    <!-- Firefox UI Tests -->
    <test name="Firefox UI Tests">
        <parameter name="browser" value="firefox"/>
        <packages>
            <package name="com.webqa.tests.ui"/>
        </packages>
    </test>

    <!-- API Tests, including WireMock and destructive -->
    <test name="API Tests">
        <packages>
            <package name="com.webqa.tests.api"/>
            <package name="com.webqa.tests.api.pets"/>
        </packages>
    </test>
</suite>
