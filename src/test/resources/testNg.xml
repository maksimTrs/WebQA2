<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="All Test Suite" parallel="methods" thread-count="2">
    <listeners>
        <listener class-name="com.webqa.tests.listeners.TestListener"/>
    </listeners>
    <test name="All Tests">
        <groups>
            <run>
                <exclude name="wiremock"/>
                <exclude name="destructive"/>
            </run>
        </groups>
        <packages>
            <package name="com.webqa.tests.api"/>
            <package name="com.webqa.tests.api.pets"/>
            <package name="com.webqa.tests.ui"/>
        </packages>
    </test>
</suite>
