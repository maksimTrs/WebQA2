<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="API Test Suite" parallel="methods" thread-count="2">
    <listeners>
        <listener class-name="com.webqa.core.listeners.TestListener"/>
    </listeners>
    <test name="API Tests">
        <groups>
            <run>
                <exclude name="wiremock"/>
            </run>
        </groups>
        <packages>
            <package name="com.webqa.tests.api"/>
            <package name="com.webqa.tests.api.pets"/>
        </packages>
    </test>
</suite>
